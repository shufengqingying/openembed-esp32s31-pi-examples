menu "LVGL Example Configuration"

    config LVGL_EXAMPLE_ENABLE
        bool "Enable LVGL example component"
        default y
        help
            Enable this option to use the LVGL graphics library example component.
            If disabled, the component initialization function will do nothing.

    if LVGL_EXAMPLE_ENABLE

        config LVGL_EXAMPLE_TASK_PRIORITY
            int "LVGL task priority"
            range 1 25
            default 1
            help
                Priority of the LVGL task.
                Higher number means higher priority. Default is 3.

        config LVGL_EXAMPLE_TASK_STACK_SIZE
            int "LVGL task stack size (KB)"
            range 1 64
            default 16
            help
                Stack size in KB for the LVGL task.
                Default is 16KB.

        config LVGL_EXAMPLE_GPIO_PIN
            int "LVGL indicator GPIO pin number"
            range 0 61
            default 55
            help
                GPIO pin number to set high when LVGL demo is active.
                Default: GPIO55
    

    choice LVGL_EXAMPLE_UI_SELECTION
        prompt "LVGL UI Demo Selection"
        default LVGL_EXAMPLE_UI_IDF
        help
            Select which LVGL UI demo to run at startup.
            
            Option 1: IDF Default Demo
            - Uses the standard ESP-IDF LVGL demo (lvgl_demo_ui.c)
            - Located at: components/lvgl_example/lvgl_demo_ui.c
            - Always available, no additional configuration required.
            
            Option 2: EEZ Studio Generated UI
            - Uses UI generated by EEZ Studio graphical designer
            - Located at: components/eez_example/ui/ui.c
            - Requires EEZ Studio generated files to be present.
            
            Option 3: LVGL Official Demos
            - Uses LVGL's official demos (lv_demo_widgets, lv_demo_music, etc.)
            - IMPORTANT: Must enable demos in LVGL configuration first:
            Component config -> LVGL configuration -> Examples
            - If not enabled, falls back to IDF Default Demo.

        config LVGL_EXAMPLE_UI_IDF
            bool "IDF Default Demo (lvgl_demo_ui.c)"

        config LVGL_EXAMPLE_UI_EEZ
            bool "EEZ Studio Generated UI (ui.c)"

        config LVGL_EXAMPLE_UI_LVGL_DEMO
            bool "LVGL Official Demos (lv_demo_*.c)"
    endchoice

    choice EXAMPLE_LCD_BUFFER_MODE
        prompt "RGB LCD Buffer Mode"
        default EXAMPLE_USE_SINGLE_FB
        help
            Select the LCD buffer mode.

        config EXAMPLE_USE_SINGLE_FB
            bool "Use single frame buffer"
            help
                Allocate one frame buffer in the driver.
                Allocate one draw buffer in LVGL.

        config EXAMPLE_USE_DOUBLE_FB
            bool "Use double frame buffer"
            help
                Allocate two frame buffers in the driver.
                The frame buffers also work as ping-pong draw buffers in LVGL.

        config EXAMPLE_USE_BOUNCE_BUFFER
            bool "Use bounce buffer"
            help
                Allocate one frame buffer in the driver.
                Allocate two bounce buffers in the driver.
                Allocate one draw buffer in LVGL.
    endchoice

    choice EXAMPLE_LCD_DATA_LINES
        prompt "RGB LCD Data Lines"
        default EXAMPLE_LCD_DATA_LINES_16
        help
            Select the number of data lines of the RGB LCD.

        config EXAMPLE_LCD_DATA_LINES_16
            bool "16 data lines"

        config EXAMPLE_LCD_DATA_LINES_24
            bool "24 data lines"
    endchoice

    config EXAMPLE_LCD_DATA_LINES
        int
        default 16 if EXAMPLE_LCD_DATA_LINES_16
        default 24 if EXAMPLE_LCD_DATA_LINES_24

    menu "RGB LCD GPIO assignment"
